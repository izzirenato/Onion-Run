<config>
    <window>
        <width>800</width>
        <height>600</height>
    </window>

    <game>
        <lanes>
            <lane>250</lane>
            <lane>400</lane>
            <lane>550</lane>
        </lanes>
        <ground_y>400</ground_y>
        <speed>6</speed>
        <fps>60</fps>
        <collision>
            <distance_threshold>50</distance_threshold>
            <player_z_index>18</player_z_index>
            <obstacle_spawn_threshold>200</obstacle_spawn_threshold>
            <player_z_indices>
                <running>15</running>
                <jumping>18</jumping>
                <crouching>5</crouching>
            </player_z_indices>
        </collision>
        <physics>
            <jump_velocity>-15</jump_velocity>
            <gravity>0.8</gravity>
            <lane_switch_speed>8</lane_switch_speed>
        </physics>
        <player>
            <collision_factors>
                <width>0.8</width>
                <height>0.9</height>
                <jump_width>0.7</jump_width>
                <jump_height>0.8</jump_height>
                <crouch_width>0.8</crouch_width>
                <crouch_height>0.6</crouch_height>
            </collision_factors>
            <movement_factor>0.2</movement_factor>
            <animation_delay>150</animation_delay>
            <crouch_duration>1000</crouch_duration>
        </player>
        <obstacles>
            <interval>1500</interval>
            <max>10</max>
            <max_spawn_attempts>3</max_spawn_attempts>
            <fallback_timer_divisor>2</fallback_timer_divisor>
            <z_indices>
                <pan>10</pan>
                <knife_block>7</knife_block>
                <cabbage>5</cabbage>
                <default>5</default>
            </z_indices>
        </obstacles>
        <difficulty>
            <increase_rate>0.5</increase_rate>
            <initial>1.5</initial>
            <max>5</max>
            <interval>60000</interval>
        </difficulty>
        <score>
            <rate>0.01</rate>
        </score>
        <pause>
            <hide_duration>300</hide_duration>
            <pause_duration>3000</pause_duration>
            <countdown_interval>1000</countdown_interval>
        </pause>
        <effects>
            <blink_interval>500</blink_interval>
            <game_over_flash_speed>500</game_over_flash_speed>
        </effects>
    </game>

    <skins>
        <purple_unlock_score>300</purple_unlock_score>
        <white_unlock_score>700</white_unlock_score>
        <all_possible>
            <skin>PyOnionFront.png</skin>
            <skin>PyOnionFrontPurple.png</skin>
            <skin>PyOnionFrontWhite.png</skin>
        </all_possible>
        <default>PyOnionFront.png</default>
    </skins>

    <record_file>high_score.txt</record_file>

    <volumes>
        <menu_music>0.5</menu_music>
        <game_music>0.7</game_music>
        <game_over_music>0.6</game_over_music>
    </volumes>

    <colors>
        <WHITE>255,255,255</WHITE>
        <BLACK>0,0,0</BLACK>
        <ORANGE>254,127,63</ORANGE>
        <BROWN>200,100,50</BROWN>
        <PURPLE>100,50,200</PURPLE>
        <BLUE>50,100,200</BLUE>
        <GREY>100,100,100</GREY>
        <DARK_GREY>50,50,50</DARK_GREY>
        <RED>255,0,0</RED>
        <DARK_RED>150,0,0</DARK_RED>
        <LIGHT_GREY>150,150,150</LIGHT_GREY>
        <MAGENTA>255,100,255</MAGENTA>
        <TRANSPARENT_BLACK>0,0,0,128</TRANSPARENT_BLACK>
        <TRANSPARENT_WHITE>255,255,255,180</TRANSPARENT_WHITE>
    </colors>

    <assets>
        <fonts>
            <main>assets/fonts/bungee.ttf</main>
        </fonts>
        <images>
            <icon>assets/images/characters/player/onion/PyOnionFront.png</icon>
            <menu_bg>assets/images/backgrounds/PyBackground.png</menu_bg>
            <game_bg>assets/images/backgrounds/PyGameBackground.png</game_bg>
            <game_bg_floor>assets/images/backgrounds/PyGameBackgroundFloor.png</game_bg_floor>
            <game_over_bg>assets/images/backgrounds/PyGameOverBackground.png</game_over_bg>

            <obstacles>
                <cabbage>assets/images/obstacles/cabbage.png</cabbage>
                <knife_block>assets/images/obstacles/knifeBlock.png</knife_block>
                <pan>assets/images/obstacles/pan.png</pan>
            </obstacles>

            <chef>
                <left>assets/images/characters/chef/PyChefLeft.png</left>
                <back>assets/images/characters/chef/PyChefBack.png</back>
                <right>assets/images/characters/chef/PyChefRight.png</right>
            </chef>

            <player>
                <the_onion>
                    <back>assets/images/characters/player/onion/PyOnionBack.png</back>
                    <crouch>assets/images/characters/player/onion/PyOnionCrouch.png</crouch>
                    <crying>assets/images/characters/player/onion/PyOnionCrying.png</crying>
                    <jump>assets/images/characters/player/onion/PyOnionJump.png</jump>
                    <left_foot_up>assets/images/characters/player/onion/PyOnionLeftFootUp.png</left_foot_up>
                    <right_foot_up>assets/images/characters/player/onion/PyOnionRightFootUp.png</right_foot_up>
                </the_onion>
                <purple>
                    <back>assets/images/characters/player/purple/PyOnionBackPurple.png</back>
                    <crouch>assets/images/characters/player/purple/PyOnionCrouchPurple.png</crouch>
                    <jump>assets/images/characters/player/purple/PyOnionJumpPurple.png</jump>
                    <left_foot_up>assets/images/characters/player/purple/PyOnionLeftFootUpPurple.png</left_foot_up>
                    <right_foot_up>assets/images/characters/player/purple/PyOnionRightFootUpPurple.png</right_foot_up>
                </purple>
                <white>
                    <back>assets/images/characters/player/white/PyOnionBackWhite.png</back>
                    <crouch>assets/images/characters/player/white/PyOnionCrouchWhite.png</crouch>
                    <jump>assets/images/characters/player/white/PyOnionJumpWhite.png</jump>
                    <left_foot_up>assets/images/characters/player/white/PyOnionLeftFootUpWhite.png</left_foot_up>
                    <right_foot_up>assets/images/characters/player/white/PyOnionRightFootUpWhite.png</right_foot_up>
                </white>
            </player>

            <skins>
                <the_onion>assets/images/characters/player/onion/PyOnionFront.png</the_onion>
                <purple>assets/images/characters/player/purple/PyOnionFrontPurple.png</purple>
                <white>assets/images/characters/player/white/PyOnionFrontWhite.png</white>
            </skins>
        </images>
        <sounds>
            <menu_music>assets/sounds/menuMusic.wav</menu_music>
            <game_music>assets/sounds/gameMusic.wav</game_music>
            <game_over_music>assets/sounds/gameOverMusic.wav</game_over_music>
        </sounds>
    </assets>

    <ui>
        <score_box>
            <width>120</width>
            <x>60</x>
            <y>30</y>
        </score_box>
        <controls_box>
            <width>120</width>
            <x>60</x>
            <y>30</y>
        </controls_box>
        <oval_button>
            <width>500</width>
            <height>100</height>
        </oval_button>
        <font_sizes>
            <title>72</title>
            <subtitle>56</subtitle>
            <large>48</large>
            <bigger>40</bigger>
            <medium>36</medium>
            <normal>32</normal>
            <small>24</small>
            <tiny>20</tiny>
            <mini>18</mini>
            <micro>16</micro>
        </font_sizes>
    </ui>
</config>